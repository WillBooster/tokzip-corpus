{
  "name": "tokzip-corpus",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:nl": "bun scripts/corpus/fetchNl.ts",
    "fetch:oss:quick": "bun scripts/corpus/fetchOss.ts --quick",
    "rebuild:quick": "bun run fetch:nl && bun run fetch:oss:quick && bun run split",
    "split": "bun scripts/corpus/split.ts",
    "typecheck": "tsc --noEmit",
    "validate": "bun scripts/corpus/validate.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
