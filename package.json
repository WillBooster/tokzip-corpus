{
  "name": "tokzip-corpus",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tokzip-corpus.git"
  },
  "license": "UNLICENSED",
  "author": "WillBooster Inc.",
  "type": "module",
  "scripts": {
    "cleanup": "bun wb lint --fix --format",
    "fetch:nl": "bun scripts/corpus/fetchNl.ts",
    "fetch:oss": "bun scripts/corpus/fetchOss.ts",
    "fetch:oss:quick": "bun scripts/corpus/fetchOss.ts --quick",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "lefthook install || true",
    "rebuild": "bun run fetch:nl && bun run fetch:oss && bun run split",
    "rebuild:quick": "bun run fetch:nl && bun run fetch:oss:quick && bun run split",
    "split": "bun scripts/corpus/split.ts",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "validate": "bun scripts/corpus/validate.ts",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "@willbooster/wb": "21.1.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2"
  }
}
